[gd_resource type="TileSet" format=3 uid="uid://bhvjuht73f512"]

; Phase 2 TileSet: both Phase 1 PixelLab Wang sheets as atlas sources (settlement = source 0,
; ruins = source 1). Physics layer 0 is the "world" collision layer (project.godot layer 1):
; every ruins tile containing rubble (all except the pure-planks tile 0:3) carries a full-square
; collision polygon, so rubble painted on an obstacles TileMapLayer is solid while plank floors
; stay walkable. Settlement (grass/soil) tiles never collide.
; (Comment block restored after a Godot resource rewrite stripped it — the rewrite also dropped
; the explicit `tile_size = Vector2i(16, 16)` line, which is safe: 16x16 is TileSet's default.)

[ext_resource type="Texture2D" uid="uid://dg1ifml2yibnp" path="res://art/tiles/settlement/grass_soil_tileset.png" id="1_grass"]
[ext_resource type="Texture2D" uid="uid://li7lmamcv4rm" path="res://art/tiles/ruins/rubble_planks_tileset.png" id="2_ruins"]

