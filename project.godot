[layer_names]

; Extensible collision-layer scheme (ROADMAP Phase 2): layer 1 = solid world terrain/obstacles,
; layer 2 = the player body, layer 3 reserved for Phase 3+ interactables (crops, props, NPCs).
; Click/interact hit-testing against visible sprite bounds (CLAUDE.md) is a Phase 3 concern and
; will layer on top of this rather than replacing it.
2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="interactable"

[rendering]

; Nearest-neighbor filtering is essential for crisp, non-blurry pixel art at any scale factor.
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.141, 0.102, 0.063, 1)
2d/snap/snap_2d_transforms_to_pixel=true
