; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Wasteland Harvest"
config/description="A post-apocalyptic farming & settlement RPG in the pixel-art style of Stardew Valley. Till irradiated-but-recovering soil, build up a scavenger settlement, and run combat expeditions into a ruined city for loot, story, and danger."
run/main_scene="res://scenes/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"

[autoload]

DayManager="*res://scripts/day_manager.gd"
GameState="*res://scripts/game_state.gd"
Events="*res://scripts/events.gd"
Audio="*res://scripts/audio_manager.gd"
Fx="*res://scripts/fx.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=192
window/size/window_width_override=1280
window/size/window_height_override=768
window/subwindows/embed_subwindows=false
window/stretch/mode="viewport"

[gui]

theme/custom="res://art/ui/ui_theme.tres"

